# Neon 등 Postgres 연결 문자열 (Vercel Environment Variables와 동일 값 권장)
# 예: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 카카오맵 JavaScript 키 — 브라우저 SDK (지도 표시)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 카카오 REST API 키 — 서버 Geocoding·길찾기 (NEXT_PUBLIC_ 붙이지 말 것)
KAKAO_REST_API_KEY=
