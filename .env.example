# Neon 등 Postgres 연결 문자열 (Vercel Environment Variables와 동일 값 권장)
# pooler 호스트면 pgbouncer=true 권장. 예:
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"

# 카카오맵 JavaScript 키 — 브라우저 SDK (지도 표시)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 카카오 REST API 키 — 서버 Geocoding·길찾기 (NEXT_PUBLIC_ 붙이지 말 것)
KAKAO_REST_API_KEY=

# Groq — 경로 자연어 제약 파싱 (서버 전용)
GROQ_API_KEY=
# 선택. 기본: openai/gpt-oss-20b (llama-3.1-8b-instant 는 폐기됨)
# GROQ_MODEL=openai/gpt-oss-20b
